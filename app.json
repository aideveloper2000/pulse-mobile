{
  "expo": {
    "name": "Pulse",
    "slug": "pulse-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0e",
    "scheme": "pulse",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulse.mobile"
    },
    "android": {
      "package": "com.pulse.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#0a0a0e"
    },
    "plugins": ["expo-audio"]
  }
}
